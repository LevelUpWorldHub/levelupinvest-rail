# LevelUpInvest web — every value is intentionally EMPTY. Never commit real values.
# Set these in Vercel project env vars or a local .env.local (gitignored).

# --- App ---
APP_URL=

# --- Auth.js (email magic link via Resend) ---
# 32+ random bytes, e.g. `openssl rand -base64 32`
AUTH_SECRET=
AUTH_RESEND_KEY=
AUTH_EMAIL_FROM=

# --- Database (Postgres, e.g. Neon via Vercel Marketplace) ---
DATABASE_URL=

# --- Encryption of Plaid access tokens at rest ---
# base64 of exactly 32 random bytes: `openssl rand -base64 32`
TOKEN_ENCRYPTION_KEY=
# Key id stored with each ciphertext (bump when rotating), e.g. v1
TOKEN_ENCRYPTION_KEY_ID=

# --- Stripe (Phase 1: TEST MODE ONLY; restricted rk_test_ key preferred) ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO_MONTHLY=
STRIPE_PRICE_PRO_YEARLY=
# Leave empty. Setting to "true" is the only way live keys are accepted (Phase 2+).
STRIPE_ALLOW_LIVE=

# --- Plaid (Phase 1: sandbox only) ---
PLAID_CLIENT_ID=
PLAID_SECRET=
PLAID_ENV=
