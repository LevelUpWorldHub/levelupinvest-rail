# Copy to .env (never commit .env). Leave everything empty to run on MOCK data (the default).
# Plaid is enabled ONLY when PLAID_CLIENT_ID and PLAID_SECRET are set and PLAID_ENV is sandbox or production.
PLAID_CLIENT_ID=
PLAID_SECRET=
PLAID_ENV=
# Comma-separated Plaid access tokens obtained from the Link flow (read-only transactions items).
PLAID_ACCESS_TOKENS=
